<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Match the /MD runtime used by the native library and Rust dependency. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 /guard:cf %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/DYNAMICBASE /HIGHENTROPYVA /NXCOMPAT /GUARD:CF %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
